# Copie este modelo para os segredos do Streamlit Community Cloud.
# Nunca publique os valores reais no GitHub.

[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"
cookie_secret = "COLE_UMA_CHAVE_ALEATORIA_LONGA"
client_id = "CLIENT_ID_DO_AUTH0"
client_secret = "CLIENT_SECRET_DO_AUTH0"
server_metadata_url = "https://SEU-TENANT.us.auth0.com/.well-known/openid-configuration"

[database]
# Use os dados do Session pooler do Supabase (porta 5432).
# A senha fica separada para aceitar caracteres especiais com segurança.
host = "aws-0-REGIAO.pooler.supabase.com"
port = 5432
name = "postgres"
user = "postgres.SEU_PROJETO"
password = "SUA_SENHA"
sslmode = "require"

[solaros]
solaros_require_auth = true
solaros_seed_demo = false
solaros_allowed_emails = ["seu-email@empresa.com.br"]
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
solaros_encryption_key = "CHAVE_FERNET_GERADA"
# "gemini" usa a camada gratuita; "openai" mantém a alternativa paga.
solaros_ai_provider = "gemini"

[gemini]
# Camada gratuita disponível no Google AI Studio: https://aistudio.google.com/app/apikey
api_key = "SUA_CHAVE_GEMINI"
model = "gemini-3.7-flash"

# Opcional: alternativa paga. Para priorizá-la, use solaros_ai_provider = "openai" em [solaros].
[openai]
api_key = "SUA_CHAVE_OPENAI"
model = "gpt-5-mini"

# Opcional: envio oficial pelo WhatsApp Business Cloud API da Meta.
# Para conversas iniciadas pela empresa, cadastre um template aprovado com
# três variáveis no corpo: nome do cliente, título e mensagem.
[whatsapp]
whatsapp_access_token = "TOKEN_PERMANENTE_META"
whatsapp_phone_number_id = "ID_DO_NUMERO"
whatsapp_api_version = "v23.0"
whatsapp_template_name = "grid_alerta"
whatsapp_template_language = "pt_BR"

# Opcional: envio de e-mails pelo provedor da empresa.
[email]
smtp_host = "smtp.seuprovedor.com"
smtp_port = 587
smtp_username = "usuario"
smtp_password = "senha"
smtp_from_email = "contato@suaempresa.com.br"
smtp_from_name = "GRID Engenharia"
smtp_security = "starttls"
